# Copy this file to `.env` and fill in your Neo4j Sandbox details.
# In Neo4j Sandbox, open the "Recommendations" project and look at the
# "Connection details" / "Connect via drivers" tab.
# `.env` is read automatically by build_pilot_dataset.py. Do NOT commit `.env`.

NEO4J_URI=bolt://<host>:<port>
NEO4J_USERNAME=neo4j
NEO4J_PASSWORD=<your-sandbox-password>
# NEO4J_DATABASE=neo4j
